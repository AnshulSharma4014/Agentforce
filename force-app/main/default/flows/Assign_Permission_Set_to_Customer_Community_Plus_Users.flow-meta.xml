<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Assign the permission set names to the &apos;Permission_Set_Names&apos; variable that will be used to query the permission sets.</description>
        <name>Assign_Permission_set_Names</name>
        <label>Assign Permission set Names</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Permission_Set_Names</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>EinsteinGPTPromptTemplateUser</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Permission_Set_Names</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>Northwind_Community_Policy_Access</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Permission_Set_Names</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>Customer_Community_Plus_Data_Cloud_Access</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Fetch_Permission_set</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <interviewLabel>Assign Permission Set to Customer Community Plus Users {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Assign Permission Set to Customer Community Plus Users</label>
    <loops>
        <name>Assign_Each_Permission_Set</name>
        <label>Assign Each Permission Set</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Permission_Set_Names</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Create_Permission_set_Assignment_Records</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Create a Permission set Assignment Record</description>
        <name>Create_Permission_set_Assignment_Records</name>
        <label>Create Permission set Assignment Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_Each_Permission_Set</targetReference>
        </connector>
        <inputAssignments>
            <field>AssigneeId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PermissionSetId</field>
            <value>
                <elementReference>Fetch_Permission_set.Id</elementReference>
            </value>
        </inputAssignments>
        <object>PermissionSetAssignment</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Get the Northwind Community Policy Access permission set</description>
        <name>Fetch_Permission_set</name>
        <label>Fetch Permission set</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Each_Permission_Set</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>In</operator>
            <value>
                <elementReference>Permission_Set_Names</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PermissionSet</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterFormula>{!$Record.Profile.Name} = &apos;Customer Community Plus User&apos;</filterFormula>
        <object>User</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Assign_Permission_set_Names</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <description>Permission set API names that needs to be queried</description>
        <name>Permission_Set_Names</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
