    <decisions>
        <description>Decision on the apex action to call</description>
        <name>Which_Apex_Action_to_Call</name>
        <label>Which Apex Action to Call?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Action</defaultConnectorLabel>
        <rules>
            <name>Call_List_My_Policies</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>callableApexAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>listMyPolicies</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>List_User_Policies</targetReference>
            </connector>
            <label>Call List My Policies</label>
        </rules>
        <rules>
            <name>Call_Get_Policy_Details</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>callableApexAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>getPolicyDetails</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>policyNumber</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Policy_Details</targetReference>
            </connector>
            <label>Call Get Policy Details</label>
        </rules>
    </decisions>
